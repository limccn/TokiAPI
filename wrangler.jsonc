// Cloudflare Workers configuration for TokiAPI — **Deploy to Cloudflare 按钮形态**（提交入库）。
//
// 本文件是仓库内唯一的常驻 wrangler 配置：本地 dev / build / test（vite 插件与 vitest-pool-workers
// 按发现顺序找到它）与一键部署（Workers Builds）共用。维护者的生产部署走 gitignored 的
// `wrangler.prod.jsonc`（真实域名 routes + 真实资源 id + 真实个性化 vars），由
// `npm run deploy`（scripts/deploy.mjs）自动选择：prod fork 存在则用之，否则用本文件。
//
// **三条写配置前必须知道的陷阱**：
//  1. **占位资源 id 是双安装器期望的形态**：Deploy to Cloudflare 按钮会按本文件的 D1/KV/Queues
//     声明自动供给资源并把真实 id 回写到用户仓库里的这份配置；Appflare（appflare.dev，第三方
//     自托管平台）安装器对 $NAME 式占位 id 同样自动供给。本文件用 **$NAME 占位符**承载「待供给」
//     语义（tests/config-fork.test.ts 钉住此形态；KV id 连空串都被 wrangler 校验硬拒，
//     故统一用占位符而非空串）。本地 miniflare 不校验真实 id。
//  2. **`wrangler deploy --dry-run` 不校验 `[[queues.producers]]` 指向的队列是否存在**（2026-09-22
//     实测）——dry-run 绿只证明配置结构合法，**不能当"资源就绪"检查**；资源就绪以账号侧实查为准
//     （`wrangler queues list` / `wrangler kv namespace list`）。
//  3. **queue() 按队列名精确比对分流**（src/index.ts）：`BILLING_QUEUE_NAME` 必须与
//     `[[queues.producers]]` 里 BILLING_QUEUE 的 `queue` 字面一致，否则计费批会落进用量分支、
//     被 usageEventSchema 拒掉 —— **静默不扣费且账上无痕**。改队列名时两处必须一起改。
//
// **刻意不写 routes / placement**：一键部署用户没有本仓维护者的自定义域名（声明 custom_domain
// 会因域名不属于部署者账号而 deploy 失败）；Workers 平台默认给出 `<worker>.<subdomain>.workers.dev`
// 子域，域分流中间件对「无法归类 host 按路径转发 + 未配置 API_DOMAIN 即整体关闭」的行为保证
// workers.dev 开箱可用（见 src/middleware/domain-split.ts）。需要自定义域名的部署方在部署后于
// dashboard 绑定，或改用维护者形态的 wrangler.prod.jsonc。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // --- 静态资源（M6）：Vite 构建产物（React SPA）由 Worker 托管 ---
  // run_worker_first = true：全部请求先到 Worker（Hono 处理 /api/*、/v1/*），
  // 其余路径由 Worker 内 env.ASSETS.fetch() 兜底托管。
  // not_found_handling=single-page-application：React Router 深链（/login、/keys 等）回退 index.html。
  // Workers Builds 会先执行 package.json 的 build script（vite build）产出 dist/client，再 deploy。
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // --- D1：事实库（users / api_keys / providers / balance_tx / request_logs / usage_daily / models） ---
  // database_id 用 $NAME 占位符 = 「待供给」语义：Deploy to Cloudflare 按钮流程自动供给后回写
  // 真实值；Appflare（第三方自托管平台）安装器对 $NAME/$绝对占位符同样自动供给（2026-10-15 适配）；
  // 本地 miniflare 不校验真实存在（仅要求非空字符串 —— KV 侧连空串都被 wrangler 硬拒，
  // 故不用空串形态，两资源统一 $NAME 占位）。
  // 迁移不随部署自动执行 —— `npm run deploy`（scripts/deploy.mjs）在 deploy 前
  // 跑 `wrangler d1 migrations apply DB --remote`（按 **binding 名** DB 引用，官方推荐形态）；
  // Appflare 安装器则自动执行 migrations_dir 下的迁移。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-ai-gateway-db",
      "database_id": "$TOKIAPI_D1_ID",
      "migrations_dir": "drizzle"
    }
  ],

  // --- KV：响应缓存 + 限流固定窗口计数器（M4 使用）---
  "kv_namespaces": [
    { "binding": "CACHE_KV", "id": "$TOKIAPI_KV_ID" }
  ],

  // --- 认证面限流（09-28-auth-rate-limit-fix；security-audit 2026-09-23 的 F1 修复）---
  // **策略（limit/period）只在这里，代码侧只传 `{ key }`** —— workerd 生成的 `RateLimitOptions`
  // 只有 key 字段，本地 miniflare 虽接受逐调用覆写但生产无此契约。
  // period 只能是 10 或 60（wrangler schema 的 enum）。namespace_id 是**账号级**命名空间：
  // 不同用户各自部署到各自账号，同值不互撞；改档位改这里即可，不用改代码、不用发版。
  "ratelimits": [
    { "name": "AUTH_CREDENTIAL_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  // --- Queues：用量聚合 + 延迟计费异步管道（M5 / 08-31-perf-v2）---
  // Queues 在 Workers Free 与 Paid 计划均可用（官方 "Available on Free and Paid plans"；
  // 2026-10-15 实证：本仓生产队列在免费账号正常运行）。差异是额度与保留期：
  // Free 10,000 ops/天（≈3,300 条计费消息）+ 消息保留 24h（不可配置）；Paid 100 万 ops/月 +
  // 保留默认 4 天可调 14 天。队列名即资源名默认值（setup 页可改）；
  // 改名时同步 [vars].BILLING_QUEUE_NAME（见文件头陷阱 3）。
  "queues": {
    "producers": [
      { "binding": "USAGE_QUEUE", "queue": "cf-ai-gateway-usage" },
      { "binding": "BILLING_QUEUE", "queue": "cf-ai-gateway-billing" }
    ],
    "consumers": [
      { "queue": "cf-ai-gateway-usage", "max_batch_size": 32, "max_retries": 3 },
      { "queue": "cf-ai-gateway-billing", "max_batch_size": 32, "max_retries": 3 }
    ]
  },

  // --- Cron：request_logs 保留期清理（M5 5.4；UTC 每日 02:00；本地 wrangler dev 不自动触发）---
  "triggers": {
    "crons": ["0 2 * * *"]
  },

  // --- 非敏感运行时配置（23 键，安全缺省）---
  // 治理规则：四个真实 secret（名单见 .dev.vars.example 与 README 部署章节）**绝不进本文件**，
  // 只走 `.dev.vars`（一键部署 setup 页输入项通道）或
  // `wrangler secret put`。个性化值（BETTER_AUTH_URL / GITHUB_CLIENT_ID / ADMIN_EMAILS）
  // 双通道：本文件缺省 + `.dev.vars.example`（setup 页输入）；一键部署输入值的落盘形态是文档盲区，
  // 部署后按 README「部署后收尾清单」用 Dashboard / `wrangler secret put` 兜底核对。
  "vars": {
    // Better Auth 站点 URL —— **同时是双域名分流的"平台域"真源**（`new URL(...).hostname`，
    // 见 src/lib/domains.ts）。不留空：undefined 会让 `new URL()` 抛错打爆 /api/auth；
    // localhost 是已知的错误值特征（管理面 301 到 localhost），部署后必须改成实际 origin。
    "BETTER_AUTH_URL": "http://localhost:5173",
    // GitHub OAuth App Client ID（非秘密）。占位 = GitHub 登录不可用直至配置（README 收尾清单）。
    "GITHUB_CLIENT_ID": "replace-me-github-client-id",
    // 管理员邮箱名单（逗号分隔；11-06-sms-alicloud-auth）。
    // 语义是**自动提权**而非登录准入：名单内邮箱的账号在注册与每次登录时成为 admin（只升不降），
    // GitHub 登录本身不再受名单限制。**空 = 无人自动提权**（不锁死：手工 D1 UPDATE 仍可 bootstrap）。
    "ADMIN_EMAILS": "",
    // request_logs 明细保留天数（cron 清理用）
    "REQUEST_LOG_RETENTION_DAYS": "30",
    // 网关 API Key 明文前缀（仅影响新生成 Key）
    "API_KEY_PREFIX": "sk-",
    // 延迟计费队列名（queue() handler 按队列名精确比对分流；必须与上面 BILLING_QUEUE 的 queue 一致）
    "BILLING_QUEUE_NAME": "cf-ai-gateway-billing",
    // 全局响应缓存总开关（09-03-stg-cache-investigation）：缺省/false = 关闭（fail-closed）
    "CACHE_ENABLED": "false",
    // modelcap 档位乘算常数（09-16 kv-ops 档位化）：cap = BASE × MULT × 档位
    // （src/generated/modelcaps.ts 存档位；缺省 8192 × 2 = 16384 基准；改动后需重跑 render:modelcaps + 部署）
    "MODELCAP_BASE_TOKENS": "8192",
    "MODELCAP_MULTIPLIER": "2",
    // 三档赠金金额（USD，11-08-reward-semantics-overhaul 起语义与绑定动作一一对应）：
    //   SIGNUP_BONUS_AMOUNT       = 手机验证赠金（手机号注册 / 绑定手机）
    //   EMAIL_VERIFY_BONUS_AMOUNT = 邮箱绑定赠金（绑定并验证邮箱）
    //   GITHUB_BIND_BONUS_AMOUNT  = GitHub 绑定赠金（注册后绑定 GitHub，OAuth 直接注册不发）
    // 缺省 5（开箱即送）；显式设 0（或非法值）即不赠（涉及钱，非法配置 fail-safe 到少发）。
    // ⚠ 存量账号在本改造前即被冻结（迁移把 users.bonus_eligible 回填 false），三档一律不发。
    "SIGNUP_BONUS_AMOUNT": "5",
    "EMAIL_VERIFY_BONUS_AMOUNT": "5",
    "GITHUB_BIND_BONUS_AMOUNT": "5",
    // 邮箱验证功能总开关：缺省 false = 系统休眠（不发验证信、不发邮箱绑定赠金）
    "EMAIL_VERIFICATION_ENABLED": "false",
    // 账户安全总开关（09-21-email-admin-promotion-switch）：缺省/false = 邮件注册的账户不能提升为 admin
    "EMAIL_ACCOUNT_ADMIN_PROMOTION_ENABLED": "false",
    // 事务邮件收件人白名单（08-27-email-notification；逗号分隔）：**空 = 全放行**
    "EMAIL_ALLOWED_RECIPIENTS": "",
    // 事务邮件发件地址（11-09-readme-open-source-rewrite）：**空 = 内置 notify@tokiapi.app**
    // （仅托管实例拥有该域）。自部署者必须填自己 Resend 已验证域名下的地址，否则 Resend 拒发。
    "EMAIL_FROM": "",
    // 公开 API 域名（双域名分流）：**空 = 分流整体关闭** = 单一 workers.dev 域的正确形态。
    // 自定义双域名的部署方在部署后填写（并同时于 dashboard 绑定该域名）。
    "API_DOMAIN": "",

    // ---- 短信认证（11-06-sms-alicloud-auth；阿里云「短信认证」dypnsapi）----
    // 总开关：缺省 false = phone-number 插件**整段不注册**（端点 404、UI 入口消失），
    // 与 EMAIL_VERIFICATION_ENABLED 同一形态（开关关闭 = 结构性不存在，不是「配置了但内部 no-op」）。
    "SMS_AUTH_ENABLED": "false",
    // 短信测试号码白名单（逗号分隔，`+86` 规范形或裸 11 位）：**空 = 全放行**
    // （语义对齐 EMAIL_ALLOWED_RECIPIENTS；非空但全无效 = 全拒，fail-closed）。
    "SMS_ALLOWED_PHONES": "",
    // 短信签名名 与 模板 CODE —— 由部署方从阿里云「短信认证」控制台**补齐**。
    // 空 = **配置错误**：sendSmsCode 记 sms_config_invalid 后**抛错**，不静默跳过
    // （静默只留给「开关关 / AK 缺失 / 白名单外」三态，免得「码永远发不出、端点却一直成功」）。
    // 🔴 没有可用的只读查询端点：赠送资源不出现在短信服务的签名/模板列表里
    // （实测两者 TotalCount 均为 0 而发送成功，见任务 research R14），只能人工抄写。
    "SMS_SIGN_NAME": "",
    // 模板 CODE 有**五个系统赠送模板**（控制台「赠送模板配置」页，2026-11-06 调研）：
    //   100001 登录/注册/通用 · 100002 修改绑定号码 · 100003 重置密码
    //   100004 绑定新号码 · 100005 验证已绑定号码
    // 五者只差文案（变量同为 ${code}/${min}、频控一致），故换模板不需要改 SMS_TEMPLATE_PARAM。
    // 本键是**登录/注册/绑定**共用的主模板（缺省建议 100001）。
    "SMS_TEMPLATE_CODE": "",
    // 找回密码专用模板（可选，缺省建议 100003）：**空 = 回落 SMS_TEMPLATE_CODE**。
    // 只拆这一条岔路的原因：库的 sendOTP 把登录/注册/绑定合成一个回调（服务端分不清绑定），
    // 而 sendPasswordResetOTP 是独立回调，可以分。
    "SMS_TEMPLATE_CODE_RESET": "",
    // 模板变量映射（JSON）：值中的 ##code## 被替换为本次验证码。
    // **变量名以控制台实际模板为准**（赠送模板为 `${code}` / `${min}`）——
    // 变量名不符时改这个 vars，不改代码。缺 ##code## 或 JSON 非法 → 发送失败并记配置错误。
    "SMS_TEMPLATE_PARAM": "{\"code\":\"##code##\",\"min\":\"5\"}"
  }
}
